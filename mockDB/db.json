  "forums": [
    {
      "id": 1,
      "course_id": 101,
      "title": "Understanding Asynchronous JavaScript",
      "content": "Can someone explain how async/await works in JavaScript? I'm having trouble understanding how promises fit into it.",
      "author": "student_01",
      "author_role": "student",
      "created_at": "2025-03-01T10:30:00Z",
      "updated_at": "2025-03-01T12:45:00Z",
      "replies": [
        {
          "id": 101,
          "forum_id": 1,
          "author": "instructor_01",
          "author_role": "instructor",
          "content": "Async/await is syntactic sugar over promises. It allows you to write asynchronous code that looks synchronous. Do you have a specific example you’re struggling with?",
          "created_at": "2025-03-01T11:00:00Z",
          "updated_at": "2025-03-01T11:30:00Z"
        },
        {
          "id": 102,
          "forum_id": 1,
          "author": "student_02",
          "author_role": "student",
          "content": "Try breaking it down by first understanding how promises work. Once you get that, async/await makes more sense!",
          "created_at": "2025-03-01T11:45:00Z",
          "updated_at": "2025-03-01T11:50:00Z"
        }
      ]
    },
    {
      "id": 2,
      "course_id": 101,
      "title": "Best Practices for Structuring Angular Projects",
      "content": "What is the best folder structure for an Angular project? Should I follow a feature-based structure?",
      "author": "student_03",
      "author_role": "student",
      "created_at": "2025-02-20T14:00:00Z",
      "updated_at": "2025-02-20T14:30:00Z",
      "replies": [
        {
          "id": 103,
          "forum_id": 2,
          "author": "instructor_01",
          "author_role": "instructor",
          "content": "A feature-based structure is highly recommended. It keeps components, services, and models related to the same feature together, making the project more scalable.",
          "created_at": "2025-02-20T15:00:00Z",
          "updated_at": "2025-02-20T15:10:00Z"
        }
      ]
    }
  ]
